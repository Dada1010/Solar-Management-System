<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="020-add-payment-reversals" author="aditya">
		<validCheckSum>ANY</validCheckSum>
		<preConditions onFail="MARK_RAN">
			<not>
				<or>
					<columnExists tableName="msedcl_invoice_payments" columnName="entry_type"/>
					<columnExists tableName="msedcl_invoice_payments" columnName="reversal_of_payment_id"/>
				</or>
			</not>
		</preConditions>
		<addColumn tableName="msedcl_invoice_payments">
			<column name="entry_type" type="VARCHAR(20)"/>
			<column name="reversal_of_payment_id" type="BIGINT"/>
		</addColumn>
		<update tableName="msedcl_invoice_payments"><column name="entry_type" value="PAYMENT"/></update>
		<addNotNullConstraint tableName="msedcl_invoice_payments" columnName="entry_type" columnDataType="VARCHAR(20)"/>
		<addForeignKeyConstraint baseTableName="msedcl_invoice_payments" baseColumnNames="reversal_of_payment_id"
			referencedTableName="msedcl_invoice_payments" referencedColumnNames="id"
			constraintName="fk_payment_reversal_original"/>
		<addUniqueConstraint tableName="msedcl_invoice_payments" columnNames="reversal_of_payment_id"
			constraintName="uk_invoice_payment_reversal"/>
	</changeSet>
</databaseChangeLog>