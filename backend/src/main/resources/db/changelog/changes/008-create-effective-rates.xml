<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="008-create-effective-rates" author="aditya">
		<createTable tableName="effective_rates">
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="pk_effective_rates" nullable="false"/>
			</column>
			<column name="start_date" type="DATE">
				<constraints nullable="false"/>
			</column>
			<column name="rate_per_unit" type="DECIMAL(12,4)">
				<constraints nullable="false"/>
			</column>
			<column name="company_id" type="BIGINT"/>
			<column name="branch_id" type="BIGINT"/>
			<column name="msedcl_detail_id" type="BIGINT"/>
		</createTable>
		<addForeignKeyConstraint baseTableName="effective_rates" baseColumnNames="company_id"
			referencedTableName="companies" referencedColumnNames="id" constraintName="fk_effective_rate_company"
			deleteCascade="true"/>
		<addForeignKeyConstraint baseTableName="effective_rates" baseColumnNames="branch_id"
			referencedTableName="branches" referencedColumnNames="id" constraintName="fk_effective_rate_branch"
			deleteCascade="true"/>
		<addForeignKeyConstraint baseTableName="effective_rates" baseColumnNames="msedcl_detail_id"
			referencedTableName="customer_msedcl_details" referencedColumnNames="id"
			constraintName="fk_effective_rate_msedcl_detail" deleteCascade="true"/>
		<addUniqueConstraint tableName="effective_rates" columnNames="company_id,start_date"
			constraintName="uk_effective_rate_company_date"/>
		<addUniqueConstraint tableName="effective_rates" columnNames="branch_id,start_date"
			constraintName="uk_effective_rate_branch_date"/>
		<addUniqueConstraint tableName="effective_rates" columnNames="msedcl_detail_id,start_date"
			constraintName="uk_effective_rate_detail_date"/>
		<sql>ALTER TABLE effective_rates ADD CONSTRAINT ck_effective_rate_single_owner CHECK (
			(company_id IS NOT NULL AND branch_id IS NULL AND msedcl_detail_id IS NULL)
			OR (company_id IS NULL AND branch_id IS NOT NULL AND msedcl_detail_id IS NULL)
			OR (company_id IS NULL AND branch_id IS NULL AND msedcl_detail_id IS NOT NULL)
		)</sql>
	</changeSet>
</databaseChangeLog>