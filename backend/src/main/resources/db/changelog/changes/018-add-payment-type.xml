<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="018-add-payment-type" author="aditya">
		<addColumn tableName="msedcl_invoice_payments">
			<column name="payment_type" type="VARCHAR(20)"/>
			<column name="transaction_no" type="VARCHAR(100)"/>
		</addColumn>
		<update tableName="msedcl_invoice_payments">
			<column name="payment_type" value="CASH"/>
		</update>
		<addNotNullConstraint tableName="msedcl_invoice_payments" columnName="payment_type"
			columnDataType="VARCHAR(20)"/>
	</changeSet>
</databaseChangeLog>