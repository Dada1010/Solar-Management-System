<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="009-create-msedcl-invoices" author="aditya">
		<createTable tableName="msedcl_invoices">
			<column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" primaryKeyName="pk_msedcl_invoices" nullable="false"/></column>
			<column name="msedcl_detail_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_invoice_msedcl_detail" references="customer_msedcl_details(id)"/></column>
			<column name="consumer_no_snapshot" type="VARCHAR(50)"><constraints nullable="false"/></column>
			<column name="consumer_name_snapshot" type="VARCHAR(100)"><constraints nullable="false"/></column>
			<column name="billing_unit_snapshot" type="VARCHAR(50)"><constraints nullable="false"/></column>
			<column name="charge_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
			<column name="invoice_date" type="DATE"><constraints nullable="false"/></column>
			<column name="billing_date" type="DATE"><constraints nullable="false"/></column>
			<column name="import_current" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="import_previous" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="import_consumption" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="export_current" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="export_previous" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="export_consumption" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="generation_current" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="generation_previous" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="generation_consumption" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="previous_bank_units" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="solar_offset_units" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="bank_solar_units" type="DECIMAL(14,4)"><constraints nullable="false"/></column>
			<column name="rate_per_unit" type="DECIMAL(12,4)"><constraints nullable="false"/></column>
			<column name="solar_amount" type="DECIMAL(14,2)"><constraints nullable="false"/></column>
			<column name="mseb_bill_amount" type="DECIMAL(14,2)"><constraints nullable="false"/></column>
			<column name="invoice_amount" type="DECIMAL(14,2)"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="msedcl_invoices" columnNames="msedcl_detail_id,billing_date"
			constraintName="uk_invoice_detail_billing_date"/>
	</changeSet>
</databaseChangeLog>