<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="022-add-payment-entry-type" author="aditya">
		<preConditions onFail="MARK_RAN"><not><columnExists tableName="msedcl_invoice_payments" columnName="entry_type"/></not></preConditions>
		<addColumn tableName="msedcl_invoice_payments"><column name="entry_type" type="VARCHAR(20)"/></addColumn>
	</changeSet>
	<changeSet id="022-add-payment-reversal-link" author="aditya">
		<preConditions onFail="MARK_RAN"><not><columnExists tableName="msedcl_invoice_payments" columnName="reversal_of_payment_id"/></not></preConditions>
		<addColumn tableName="msedcl_invoice_payments"><column name="reversal_of_payment_id" type="BIGINT"/></addColumn>
	</changeSet>
	<changeSet id="022-backfill-payment-entry-type" author="aditya">
		<update tableName="msedcl_invoice_payments">
			<column name="entry_type" value="PAYMENT"/>
			<where>entry_type IS NULL OR entry_type = ''</where>
		</update>
	</changeSet>
	<changeSet id="022-require-payment-entry-type" author="aditya">
		<addNotNullConstraint tableName="msedcl_invoice_payments" columnName="entry_type" columnDataType="VARCHAR(20)"/>
	</changeSet>
	<changeSet id="022-add-payment-reversal-fk" author="aditya">
		<preConditions onFail="MARK_RAN"><not><foreignKeyConstraintExists foreignKeyName="fk_payment_reversal_original"/></not></preConditions>
		<addForeignKeyConstraint baseTableName="msedcl_invoice_payments" baseColumnNames="reversal_of_payment_id"
			referencedTableName="msedcl_invoice_payments" referencedColumnNames="id"
			constraintName="fk_payment_reversal_original"/>
	</changeSet>
	<changeSet id="022-add-payment-reversal-unique" author="aditya">
		<preConditions onFail="MARK_RAN"><not><indexExists tableName="msedcl_invoice_payments" indexName="uk_invoice_payment_reversal"/></not></preConditions>
		<addUniqueConstraint tableName="msedcl_invoice_payments" columnNames="reversal_of_payment_id"
			constraintName="uk_invoice_payment_reversal"/>
	</changeSet>
</databaseChangeLog>
