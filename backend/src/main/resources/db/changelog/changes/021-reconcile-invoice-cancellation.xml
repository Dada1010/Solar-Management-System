<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="021-add-invoice-status-column" author="aditya">
		<preConditions onFail="MARK_RAN"><not><columnExists tableName="msedcl_invoices" columnName="invoice_status"/></not></preConditions>
		<addColumn tableName="msedcl_invoices"><column name="invoice_status" type="VARCHAR(20)"/></addColumn>
	</changeSet>
	<changeSet id="021-add-invoice-reversal-link" author="aditya">
		<preConditions onFail="MARK_RAN"><not><columnExists tableName="msedcl_invoices" columnName="reversal_of_invoice_id"/></not></preConditions>
		<addColumn tableName="msedcl_invoices"><column name="reversal_of_invoice_id" type="BIGINT"/></addColumn>
	</changeSet>
	<changeSet id="021-add-original-invoice-snapshot" author="aditya">
		<preConditions onFail="MARK_RAN"><not><columnExists tableName="msedcl_invoices" columnName="original_invoice_no_snapshot"/></not></preConditions>
		<addColumn tableName="msedcl_invoices"><column name="original_invoice_no_snapshot" type="VARCHAR(160)"/></addColumn>
	</changeSet>
	<changeSet id="021-backfill-invoice-status" author="aditya">
		<update tableName="msedcl_invoices">
			<column name="invoice_status" value="OPEN"/>
			<where>invoice_status IS NULL OR invoice_status = ''</where>
		</update>
	</changeSet>
	<changeSet id="021-require-invoice-status" author="aditya">
		<addNotNullConstraint tableName="msedcl_invoices" columnName="invoice_status" columnDataType="VARCHAR(20)"/>
	</changeSet>
	<changeSet id="021-add-invoice-reversal-fk" author="aditya">
		<preConditions onFail="MARK_RAN"><not><foreignKeyConstraintExists foreignKeyName="fk_invoice_reversal_original"/></not></preConditions>
		<addForeignKeyConstraint baseTableName="msedcl_invoices" baseColumnNames="reversal_of_invoice_id"
			referencedTableName="msedcl_invoices" referencedColumnNames="id"
			constraintName="fk_invoice_reversal_original"/>
	</changeSet>
	<changeSet id="021-add-invoice-detail-fk-index" author="aditya">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="0">
				SELECT COUNT(DISTINCT index_name) FROM information_schema.statistics
				WHERE table_schema = DATABASE()
				AND table_name = 'msedcl_invoices'
				AND index_name = 'idx_msedcl_invoices_detail_id'
			</sqlCheck>
		</preConditions>
		<createIndex tableName="msedcl_invoices" indexName="idx_msedcl_invoices_detail_id">
			<column name="msedcl_detail_id"/>
		</createIndex>
	</changeSet>
	<changeSet id="021-drop-invoice-detail-date-unique" author="aditya">
		<preConditions onFail="MARK_RAN"><indexExists tableName="msedcl_invoices" indexName="uk_invoice_detail_billing_date"/></preConditions>
		<dropUniqueConstraint tableName="msedcl_invoices" constraintName="uk_invoice_detail_billing_date"/>
	</changeSet>
</databaseChangeLog>
